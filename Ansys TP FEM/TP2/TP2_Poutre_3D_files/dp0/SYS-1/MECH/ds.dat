sfe,all,3,pres,1,0.
nsel,all
esel,all
d,622,ux,0.
d,622,uy,0.
d,622,uz,0.
d,622,roty,0.
d,623,ux,0.
d,623,uz,0.
/nopr
/gopr
nsub,1,1,1
time,1.
outres,erase
