library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity TB_LAB1 is
end TB_LAB1;

architecture behavior of TB_LAB1 is

    -- Déclaration de l'entité à tester
    component LAB1
        port (
            SW   : in  std_logic_vector(2 downto 0);
            LEDG : out std_logic_vector(7 downto 0)
        );
    end component;

    -- Signaux internes pour tester
    signal SW   : std_logic_vector(2 downto 0) := "000";
    signal LEDG : std_logic_vector(7 downto 0);

begin

    -- Instanciation de LAB1
    UUT: LAB1
        port map (
            SW   => SW,
            LEDG => LEDG
        );

    -- Stimulus : SW change toutes les 100ns
    process
    begin
        for i in 0 to 7 loop
            SW <= std_logic_vector(to_unsigned(i, 3));
            wait for 100 ns;
        end loop;
        wait;
    end process;

end behavior;
